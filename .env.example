# Copy this file to .env and fill in the platforms you want to use.
# Platforms with missing credentials are reported as "failed" (the rest still post).

# 1. Telegraph (telegra.ph) - no key needed. Optional: reuse an existing token.
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR=Automated Poster

# 2. Mastodon - Preferences > Development > New application (scope: write:statuses)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 3. Bluesky - Settings > App Passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# 4. Telegram - create a bot with @BotFather, add it as admin to your public channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel_username

# 5. DEV Community - Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# 6. GitHub Gist - Settings > Developer settings > Tokens (scope: gist)
GITHUB_TOKEN=

# Optional
REQUEST_TIMEOUT=20
PORT=4000
